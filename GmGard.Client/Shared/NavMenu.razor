@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="navbar bg-base-100 shadow-sm border-b border-base-200">
    <div class="navbar-start">
        <a class="btn btn-ghost text-xl font-bold" href="">绅士应用</a>
    </div>
    @* Center empty - features are deep-linked from main site, no need to list *@
    <div class="navbar-center"></div>
    <div class="navbar-end gap-2">
        <AuthorizeView>
            <Authorized>
                <div class="dropdown dropdown-end">
                    <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                        <div class="w-9 rounded-full ring ring-base-300 ring-offset-2 ring-offset-base-100">
                            <img src="@avatarUrl" alt="avatar" />
                        </div>
                    </label>
                    <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-xl bg-base-100 rounded-box w-56 mt-2 border border-base-200">
                        <li class="menu-title px-4 py-2">
                            <span class="text-xs opacity-60">已登录</span>
                            <span class="text-sm font-semibold truncate">@context.User.Identity?.Name</span>
                        </li>
                        <div class="divider my-0"></div>
                        <li class="menu-title mt-1"><span>账号</span></li>
                        <li><NavLink href="account/2fa">两步验证</NavLink></li>
                        <li><NavLink href="account/enable2fa">开启两步验证</NavLink></li>
                        <li class="menu-title mt-1"><span>管理</span></li>
                        <li><NavLink href="admin">管理首页</NavLink></li>
                        <li><NavLink href="admin/category">分类管理</NavLink></li>
                        <li><NavLink href="admin/raffle">抽奖管理</NavLink></li>
                        <li><NavLink href="audit-exam/admin">审核考试管理</NavLink></li>
                        <div class="divider my-1"></div>
                        <li><a @onclick="Logout" class="text-error">退出登录</a></li>
                    </ul>
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="login" class="btn btn-primary btn-sm">登录</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string avatarUrl = "";

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetUserAsync();
        if (user != null)
        {
            avatarUrl = user.Avatar;
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
