@inject AuthService AuthService
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="navbar bg-base-100 shadow-sm border-b border-base-200">
    <div class="navbar-start">
        <a class="btn btn-ghost text-xl font-bold" href="">绅士应用</a>
    </div>
    @* Center empty - features are deep-linked from main site, no need to list *@
    <div class="navbar-center"></div>
    <div class="navbar-end gap-2">
        <AuthorizeView>
            <Authorized>
                <div class="dropdown dropdown-end">
                    <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                        <div class="w-9 rounded-full ring ring-base-300 ring-offset-2 ring-offset-base-100 overflow-hidden">
                            @if (string.IsNullOrEmpty(avatarUrl))
                            {
                                <div class="w-full h-full bg-base-300 flex items-center justify-center text-base-content">?</div>
                            }
                            else
                            {
                                <img src="@avatarUrl" alt="avatar" />
                            }
                        </div>
                    </label>
                    <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-xl bg-base-100 rounded-box w-56 mt-2 border border-base-200">
                        <li class="menu-title px-4 py-2">
                            <span class="text-xs opacity-60">已登录</span>
                            <span class="text-sm font-semibold truncate">@context.User.Identity?.Name</span>
                        </li>
                        <div class="divider my-0"></div>
                        <li class="menu-title mt-1"><span>账号</span></li>
                        <li><NavLink href="account/2fa">两步验证</NavLink></li>
                        <li class="menu-title mt-1"><span>管理</span></li>
                        <li><NavLink href="admin">管理首页</NavLink></li>
                        <li><NavLink href="admin/category">分类管理</NavLink></li>
                        <li><NavLink href="admin/raffle">抽奖管理</NavLink></li>
                        <li><NavLink href="audit-exam/admin">审核考试管理</NavLink></li>
                        <div class="divider my-1"></div>
                        <li><a @onclick="Logout" class="text-error">退出登录</a></li>
                    </ul>
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="login" class="btn btn-primary btn-sm">登录</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string avatarUrl = "";

    // Cascading auth state to react when Blazor's auth system updates (after login)
    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await LoadAvatar();
    }

    protected override async Task OnParametersSetAsync()
    {
        // This runs whenever cascading auth state changes (e.g. after login navigation)
        if (AuthTask != null)
        {
            var auth = await AuthTask;
            if (auth.User.Identity?.IsAuthenticated == true && string.IsNullOrEmpty(avatarUrl))
            {
                await LoadAvatar(force: true);
            }
            else if (auth.User.Identity?.IsAuthenticated != true)
            {
                avatarUrl = "";
            }
        }
    }

    private async void OnAuthStateChanged(Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> task)
    {
        // Force refresh user (avatar) when auth state provider notifies change
        await LoadAvatar(force: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAvatar(bool force = false)
    {
        var user = await AuthService.GetUserAsync(force: force);
        avatarUrl = user?.Avatar ?? "";
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
