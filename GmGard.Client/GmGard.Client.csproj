<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <StaticWebAssetBasePath>app</StaticWebAssetBasePath>
    <StaticWebAssetFingerprintingEnabled>true</StaticWebAssetFingerprintingEnabled>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
  </ItemGroup>

  <Target Name="NpmInstallAndBuild" BeforeTargets="Build">
    <Exec Command="npm install" />
    <Exec Command="npm run build:css" />
  </Target>

  <UsingTask TaskName="UpdateCssHash" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CssFilePath ParameterType="System.String" Required="true" />
      <IndexHtmlPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          using (var sha = SHA256.Create())
          {
            byte[] hashBytes = sha.ComputeHash(File.ReadAllBytes(CssFilePath));
            string hash = BitConverter.ToString(hashBytes).Replace("-", "").Substring(0, 8).ToLower();
            string content = File.ReadAllText(IndexHtmlPath);
            string updated = Regex.Replace(content, @"css/app\.min\.css(?:\?v=[a-fA-F0-9]*)?" , $"css/app.min.css?v={hash}");
            File.WriteAllText(IndexHtmlPath, updated);
            Log.LogMessage(MessageImportance.High, $"Updated CSS hash: {hash}");
          }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="AddCssHashToBust" AfterTargets="NpmInstallAndBuild">
    <UpdateCssHash
      CssFilePath="$(MSBuildProjectDirectory)/wwwroot/css/app.min.css"
      IndexHtmlPath="$(MSBuildProjectDirectory)/wwwroot/index.html" />
  </Target>

</Project>
