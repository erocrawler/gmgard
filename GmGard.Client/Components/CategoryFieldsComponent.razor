@using GmGard.Client.Data

<div class="space-y-4">
    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">前缀</label>
        <input @bind="prefix" @bind:event="oninput" @onchange="OnFieldChanged"
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary text-sm"
               placeholder="例：(全彩)、[无修正]" />
        <p class="text-xs text-gray-500 mt-1">可选的前缀标签</p>
    </div>

    @foreach (var field in Category.Fields)
    {
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
                @field.Name
                @if (field.Required)
                {
                    <span class="text-red-500">*</span>
                }
            </label>
            
            @if (field.Fixed && !field.Required)
            {
                <label class="flex items-center space-x-2">
                    <input type="checkbox" 
                           checked="@IsFieldChecked(field.Name)"
                           @onchange="e => OnCheckboxChanged(field.Name, (bool)e.Value!)"
                           class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary" />
                    <span class="text-sm">@field.Name</span>
                </label>
            }
            else
            {
                <input @bind="fieldValues[field.Name]" @bind:event="oninput" @onchange="OnFieldChanged"
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary text-sm @(field.Fixed ? "bg-gray-50" : "")"
                       placeholder="@(field.Fixed ? "" : field.Name)"
                       readonly="@field.Fixed"
                       required="@field.Required" />
                @if (!string.IsNullOrEmpty(field.Hint))
                {
                    <p class="text-xs text-gray-500 mt-1">@field.Hint</p>
                }
            }
        </div>
    }

    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">后缀</label>
        <input @bind="suffix" @bind:event="oninput" @onchange="OnFieldChanged"
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary text-sm"
               placeholder="例：[1-11话]、[DL版]、[2.33GB]" />
        <p class="text-xs text-gray-500 mt-1">可选的后缀标签</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TitleCategory Category { get; set; } = null!;

    [Parameter]
    public EventCallback<string> OnTitleChange { get; set; }

    private Dictionary<string, string> fieldValues = new();
    private string prefix = "";
    private string suffix = "";

    protected override void OnParametersSet()
    {
        fieldValues.Clear();
        prefix = "";
        suffix = "";
        
        foreach (var field in Category.Fields)
        {
            fieldValues[field.Name] = field.Default ?? "";
        }
    }

    private bool IsFieldChecked(string fieldName)
    {
        return fieldValues.ContainsKey(fieldName) && !string.IsNullOrEmpty(fieldValues[fieldName]);
    }

    private void OnCheckboxChanged(string fieldName, bool isChecked)
    {
        var field = Category.Fields.First(f => f.Name == fieldName);
        fieldValues[fieldName] = isChecked ? (field.Default ?? fieldName) : "";
        OnFieldChanged();
    }

    private void OnFieldChanged()
    {
        var formatted = FormatTitle();
        OnTitleChange.InvokeAsync(formatted);
    }

    private string FormatTitle()
    {
        var pieces = new List<string>();
        
        if (!string.IsNullOrWhiteSpace(prefix))
        {
            pieces.Add(prefix);
        }

        foreach (var field in Category.Fields)
        {
            if (fieldValues.TryGetValue(field.Name, out var value) && !string.IsNullOrWhiteSpace(value))
            {
                pieces.Add(field.Format != null ? field.Format(value) : value);
            }
        }

        if (!string.IsNullOrWhiteSpace(suffix))
        {
            pieces.Add(suffix);
        }

        return string.Join("", pieces);
    }
}
