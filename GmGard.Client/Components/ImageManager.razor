@* Blazor version of Angular image-manager - fixed to avoid IBrowserFile lifetime bug (_blazorFilesById null) *@
@using Microsoft.AspNetCore.Components.Forms

<div class="grid grid-cols-3 gap-2">
    @foreach (var img in previews)
    {
        <div class="relative border rounded-lg overflow-hidden h-[120px] bg-base-200">
            <img src="@img.DataUrl" class="w-full h-full object-cover" alt="@img.FileName" />
            <button class="absolute top-1 right-1 btn btn-circle btn-xs btn-error" @onclick="() => Remove(img)">✕</button>
            <div class="absolute bottom-0 left-0 right-0 bg-black/50 text-white text-[10px] truncate px-1">@img.FileName</div>
        </div>
    }
    @if (!Disabled && previews.Count < MaxCount)
    {
        <label class="border-2 border-dashed rounded-lg h-[120px] flex flex-col items-center justify-center cursor-pointer hover:bg-base-200">
            <span class="text-2xl">+</span>
            <span class="text-xs">添加图片 (@previews.Count / @MaxCount)</span>
            <InputFile @key="inputKey" OnChange="OnInputFileChange" multiple accept="image/*" class="hidden" />
        </label>
    }
</div>
@if (previews.Count > 0)
{
    <div class="text-xs opacity-60 mt-1">@previews.Count 张待上传，最大 @MaxCount 张，单张不超过10MB</div>
}

@code {
    [Parameter] public int MaxCount { get; set; } = 9;
    [Parameter] public bool Disabled { get; set; }
    // New: expose buffered files instead of raw IBrowserFile to avoid WASM JS interop lifetime issues
    [Parameter] public EventCallback<List<BufferedImage>> OnBufferedUpdate { get; set; }
    // Keep legacy OnUpdate for backwards compat where still used, but we will also fire buffered one
    [Parameter] public EventCallback<List<IBrowserFile>> OnUpdate { get; set; }

    List<Preview> previews = new();
    List<IBrowserFile> files = new(); // legacy
    List<BufferedImage> buffered = new();

    Guid inputKey = Guid.NewGuid();

    public class Preview
    {
        public string FileName { get; set; } = "";
        public string DataUrl { get; set; } = "";
        public BufferedImage Buf { get; set; } = null!;
        public IBrowserFile FileRef { get; set; } = null!;
    }



    async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        const long maxSize = 10L * 1024 * 1024;
        foreach (var f in e.GetMultipleFiles(MaxCount))
        {
            if (previews.Count >= MaxCount) break;
            if (f.Size > maxSize) continue;
            if (!f.ContentType.StartsWith("image/")) continue;

            try
            {
                // IMPORTANT: buffer immediately while JS file ref is alive - fixes _blazorFilesById null on later OpenReadStream
                using var stream = f.OpenReadStream(maxSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                var dataUrl = $"data:{f.ContentType};base64,{Convert.ToBase64String(bytes)}";
                var buf = new BufferedImage { FileName = f.Name, ContentType = f.ContentType, Data = bytes };
                previews.Add(new Preview { FileName = f.Name, DataUrl = dataUrl, FileRef = f, Buf = buf });
                files.Add(f);
                buffered.Add(buf);
            }
            catch (Exception ex)
            {
                System.Console.WriteLine($"[ImageManager] failed to read {f.Name}: {ex}");
            }
        }
        // reset input to allow re-selecting same file
        inputKey = Guid.NewGuid();
        await OnUpdate.InvokeAsync(files);
        await OnBufferedUpdate.InvokeAsync(buffered);
        StateHasChanged();
    }

    async Task Remove(Preview p)
    {
        previews.Remove(p);
        files.Remove(p.FileRef);
        buffered.Remove(p.Buf);
        await OnUpdate.InvokeAsync(files);
        await OnBufferedUpdate.InvokeAsync(buffered);
        StateHasChanged();
    }

    public List<IBrowserFile> GetFiles() => files;
    public List<BufferedImage> GetBufferedFiles() => buffered;
    public void Clear()
    {
        previews.Clear();
        files.Clear();
        buffered.Clear();
        inputKey = Guid.NewGuid();
        StateHasChanged();
    }
}
