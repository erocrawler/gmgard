@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="ckeditor-wrapper">
    <textarea @ref="textAreaRef" id="@ElementId" style="visibility:hidden; height:0;"></textarea>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? ElementId { get; set; } = $"ck_{Guid.NewGuid():N}";
    [Parameter] public bool ReadOnly { get; set; }

    ElementReference textAreaRef;
    bool initialized = false;
    DotNetObjectReference<CkEditor>? dotNetRef;
    IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            // Blazor native isolation – pure ESM, no window globals needed
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ck-editor.esm.js");
            await module.InvokeVoidAsync("init", ElementId, dotNetRef, Value, ReadOnly);
            initialized = true;
        }
        else if (initialized)
        {
            try { await module!.InvokeVoidAsync("setDataIfDifferent", ElementId, Value); } catch {}
        }
    }

    [JSInvokable]
    public async Task OnEditorChange(string data)
    {
        if (Value != data)
        {
            Value = data;
            await ValueChanged.InvokeAsync(data);
        }
    }

    public async ValueTask<string?> GetDataAsync()
    {
        if (!initialized) return Value;
        try { return await module!.InvokeAsync<string>("getData", ElementId); }
        catch { return Value; }
    }

    public async ValueTask DisposeAsync()
    {
        try { await module!.InvokeVoidAsync("destroy", ElementId); } catch {}
        try { await module!.DisposeAsync(); } catch {}
        dotNetRef?.Dispose();
    }
}
