@page "/game"
@attribute [Authorize]

<PageTitle>绅士冒险</PageTitle>

<div class="max-w-6xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">绅士冒险</h1>
    
    <div class="bg-white shadow-md rounded-lg p-6">
        <div class="mb-6">
            <h2 class="text-xl font-semibold mb-4">角色信息</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-gray-50 p-4 rounded">
                    <div class="text-sm text-gray-600">等级</div>
                    <div class="text-2xl font-bold">1</div>
                </div>
                <div class="bg-gray-50 p-4 rounded">
                    <div class="text-sm text-gray-600">经验</div>
                    <div class="text-2xl font-bold">0</div>
                </div>
                <div class="bg-gray-50 p-4 rounded">
                    <div class="text-sm text-gray-600">生命值</div>
                    <div class="text-2xl font-bold">100</div>
                </div>
                <div class="bg-gray-50 p-4 rounded">
                    <div class="text-sm text-gray-600">金币</div>
                    <div class="text-2xl font-bold">0</div>
                </div>
            </div>
        </div>
        
        <div>
            <h2 class="text-xl font-semibold mb-4">开始冒险</h2>
            <button class="bg-primary text-white px-6 py-2 rounded-md hover:bg-primary-dark transition">
                进入游戏
            </button>
        </div>
    </div>
</div>
