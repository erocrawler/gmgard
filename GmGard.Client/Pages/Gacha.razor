@page "/gacha"
@attribute [Authorize]

<PageTitle>绅士抽奖</PageTitle>

<div class="max-w-6xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">绅士抽奖</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white shadow-md rounded-lg p-6">
            <h2 class="text-xl font-semibold mb-4">当前抽奖活动</h2>
            <p class="text-gray-600">暂无活动</p>
        </div>
        
        <div class="bg-white shadow-md rounded-lg p-6">
            <h2 class="text-xl font-semibold mb-4">抽奖记录</h2>
            <p class="text-gray-600">暂无记录</p>
        </div>
    </div>
</div>
