@page "/message/inbox"
@attribute [Authorize]
@inject MessageService MessageService
@inject NavigationManager Navigation

<PageTitle>收件箱</PageTitle>

<div class="max-w-3xl mx-auto p-4 space-y-4">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">收件箱</h1>
        <div class="flex gap-2">
            <a href="message/inbox" class="btn btn-sm btn-primary">收件箱</a>
            <a href="message/outbox" class="btn btn-sm btn-ghost">发件箱</a>
            <a href="message/write" class="btn btn-sm btn-ghost">写消息</a>
        </div>
    </div>

    <div class="flex gap-2">
        <button class="btn btn-sm @(unreadOnly ? "btn-primary" : "btn-outline")" @onclick="() => ToggleUnread(true)">
            只看未读
        </button>
        <button class="btn btn-sm @(!unreadOnly ? "btn-primary" : "btn-outline")" @onclick="() => ToggleUnread(false)">
            全部
        </button>
    </div>

    @if (loading && messages == null)
    {
        <div class="flex justify-center py-10"><span class="loading loading-spinner loading-lg"></span></div>
    }
    else if (messages == null || messages.Items.Count == 0)
    {
        <div class="card bg-base-100 shadow"><div class="card-body"><p class="text-base-content/50">无消息！</p></div></div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var m in messages.Items)
            {
                <div class="card bg-base-100 shadow hover:shadow-lg transition border border-base-200 cursor-pointer" @onclick="() => ToggleDetail(m.MessageId)">
                    <div class="card-body p-4">
                        <div class="flex items-start gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    @if (!m.IsRead) { <span class="badge badge-primary badge-xs"></span> }
                                    <span class="font-semibold text-sm">@m.SenderNickName</span>
                                    <span class="text-xs text-base-content/50">@m.SendDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <div class="mt-1 font-medium truncate @(m.IsRead ? "text-base-content/60" : "")">@(string.IsNullOrWhiteSpace(m.Title) ? "（无标题）" : m.Title)</div>
                                @if (!string.IsNullOrEmpty(m.QuickLink))
                                {
                                    <a href="@m.QuickLink" target="_blank" class="link link-primary text-xs mt-1 inline-flex items-center gap-1" @onclick:stopPropagation="true">
                                        @m.QuickText
                                        <span>↗</span>
                                    </a>
                                }
                            </div>
                        </div>

                        @if (expandedIds.Contains(m.MessageId))
                        {
                            <div class="mt-3 pt-3 border-t border-base-200">
                                <MessageDetailsComponent Id="@m.MessageId" MarkRead="true" OnDeleted="OnDeleted" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Pagination - same style as bounty List.razor *@
        @if (messages.PageCount > 1)
        {
            <Pagination PageCount="messages.PageCount" CurrentPage="page" OnPageChanged="LoadPage" />
        }
    }
</div>

@code {
    PagedResult<MessageDisplay>? messages;
    bool loading = true;
    bool unreadOnly = false;
    int page = 1;
    HashSet<int> expandedIds = new();

    protected override async Task OnInitializedAsync()
    {
        await ParseQueryAndLoad();
    }

    async Task ParseQueryAndLoad()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (int.TryParse(q["page"], out var pg)) page = pg;
        unreadOnly = (q["unreadOnly"] == "true" || q["unreadOnly"] == "True");
        await LoadPage(page);
    }

    async Task LoadPage(int p)
    {
        loading = true;
        page = p;
        StateHasChanged();
        messages = await MessageService.InboxAsync(page, unreadOnly);
        loading = false;
        StateHasChanged();
    }

    async Task ToggleUnread(bool unread)
    {
        unreadOnly = unread;
        await LoadPage(1);
        Navigation.NavigateTo($"message/inbox?unreadOnly={unreadOnly.ToString().ToLower()}");
    }

    void ToggleDetail(int id)
    {
        if (expandedIds.Contains(id)) expandedIds.Remove(id);
        else expandedIds.Add(id);
    }

    async Task OnDeleted(int id)
    {
        expandedIds.Remove(id);
        await LoadPage(page);
    }
}
