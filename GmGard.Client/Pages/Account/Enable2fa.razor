@page "/account/enable2fa"
@attribute [Authorize]
@inject AccountService AccountService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using GmGard.Client.Services

<PageTitle>启用两步验证</PageTitle>

<div class="max-w-2xl mx-auto p-4 space-y-4">
    <h1 class="text-2xl font-bold">@(isAlreadyEnabled ? "重新绑定两步验证" : "启用两步验证")</h1>

    @if (loading)
    {
        <div class="flex justify-center py-12"><span class="loading loading-spinner loading-lg"></span></div>
    }
    else if (sharedKey != null)
    {
        @if (isAlreadyEnabled)
        {
            <div class="alert alert-warning text-sm">
                <span>两步验证已启用。当前显示的是现有秘钥，可用于在新设备上重新绑定验证器。如需更换全新秘钥，请先到 <a href="account/2fa" class="link link-primary">两步验证管理</a> 执行“重设验证秘钥”。</span>
            </div>
        }

        <div class="card bg-base-100 shadow">
            <div class="card-body gap-4">
                <p class="text-sm">使用验证器APP扫描下方二维码，或手动输入秘钥：</p>

                <div class="flex justify-center">
                    <div class="p-2 bg-white rounded-lg shadow-inner">
                        <canvas @ref="qrCanvas" width="220" height="220"></canvas>
                    </div>
                </div>

                <div class="flex flex-col gap-1">
                    <span class="text-xs text-base-content/50">秘钥 / 恢复URI</span>
                    <div class="flex gap-2">
                        <input class="input input-bordered flex-1 text-xs" readonly value="@sharedKey.SharedKey" />
                        <button class="btn btn-ghost btn-sm" @onclick="() => CopyText(sharedKey.SharedKey)">复制</button>
                    </div>
                    <span class="text-xs break-all text-base-content/50">@sharedKey.AuthenticatorUri</span>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-error text-sm"><span>@error</span></div>
                }

                <fieldset class="fieldset">
                    <legend class="fieldset-legend">验证码（来自验证器APP）</legend>
                    <div class="flex gap-2">
                        <input class="input flex-1" placeholder="6位数字" @bind="code" @bind:event="oninput" @onkeypress="OnKey" />
                        <button class="btn @(isAlreadyEnabled ? "btn-outline" : "btn-primary")" @onclick="Verify" disabled="@verifying">
                            @if (verifying) { <span class="loading loading-spinner loading-xs"></span> }
                            @(isAlreadyEnabled ? "验证秘钥" : "验证并启用")
                        </button>
                    </div>
                </fieldset>

                @if (recoveryCodes != null)
                {
                    <div class="modal modal-open">
                        <div class="modal-box max-w-lg">
                            <h3 class="font-bold text-lg">✅ 两步验证已启用</h3>
                            <p class="text-sm mt-2">请妥善保存以下应急密码，在验证器APP不可用时可使用应急密码登录。应急密码为一次性密码，使用后作废。</p>
                            <div class="alert alert-warning text-xs py-2 mt-2">
                                <span><b>⚠️ 本信息只显示一次</b>，请在关闭前保存至安全位置（如邮箱、加密笔记）。旧应急密码已作废。</span>
                            </div>
                            <div class="bg-base-200 rounded p-3 font-mono text-sm space-y-1 mt-3 select-all cursor-pointer" @onclick="CopyAllCodes" title="点击复制全部">
                                @foreach (var c in recoveryCodes) { <div>@c</div> }
                            </div>
                            <p class="text-xs opacity-50 mt-2">点击上方区域可复制全部应急密码。已生成 @recoveryCodes.Length 个密码替换旧密码。</p>
                            <div class="modal-action">
                                <button class="btn btn-primary" @onclick="GoTo2Fa">我已记录应急密码</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-error"><span>加载失败，请刷新重试。</span></div>
    }
</div>

@code {
    TwoFactorAuthSharedKey? sharedKey;
    TwoFactorAuthenticationModel? status;
    bool isAlreadyEnabled => status?.Is2faEnabled == true;
    bool loading = true;
    bool verifying = false;
    string code = "";
    string? error;
    string[]? recoveryCodes;
    ElementReference qrCanvas;
    IJSObjectReference? module;

    protected override async Task OnInitializedAsync()
    {
        // Load both status and key in parallel – handles already-enabled case
        var dataTask = AccountService.Get2FaDataAsync();
        var keysTask = AccountService.Get2FaKeysAsync();
        await Task.WhenAll(dataTask, keysTask);
        status = await dataTask;
        sharedKey = await keysTask;
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // enable2fa.min.js is built via npm run build:js (gitignored like site.min.js);
                // fallback to unminified enable2fa.js when building without npm / in dev
                try
                {
                    module = await JS.InvokeAsync<IJSObjectReference>("import", ApiRoutes.Js.Enable2faMin);
                }
                catch
                {
                    module = await JS.InvokeAsync<IJSObjectReference>("import", ApiRoutes.Js.Enable2fa);
                }
                if (sharedKey != null && !string.IsNullOrEmpty(sharedKey.AuthenticatorUri))
                {
                    await module.InvokeVoidAsync("renderQrCode", qrCanvas, sharedKey.AuthenticatorUri);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"QR module load/render failed: {ex.Message}");
            }
        }
        else if (sharedKey != null && !string.IsNullOrEmpty(sharedKey.AuthenticatorUri) && module != null)
        {
            try { await module.InvokeVoidAsync("renderQrCode", qrCanvas, sharedKey.AuthenticatorUri); } catch { }
        }
    }

    async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Verify();
    }

    async Task Verify()
    {
        if (string.IsNullOrWhiteSpace(code)) { error = "请输入验证码"; return; }
        verifying = true;
        error = null;
        var (ok, codes, err) = await AccountService.Enable2FaAsync(code.Trim());
        verifying = false;
        if (ok)
        {
            recoveryCodes = codes;
            if (recoveryCodes == null)
            {
                Navigation.NavigateTo("account/2fa");
            }
        }
        else
        {
            error = err ?? "验证码错误，请重试";
        }
    }

    void GoTo2Fa() => Navigation.NavigateTo("account/2fa");

    async Task CopyAllCodes()
    {
        if (recoveryCodes == null) return;
        var all = string.Join("\n", recoveryCodes);
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", all); } catch {}
    }

    async Task CopyText(string text)
    {
        try
        {
            if (module != null) await module.InvokeVoidAsync("copyText", text);
            else await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch { }
    }
}
