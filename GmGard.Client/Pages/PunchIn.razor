@page "/punch-in"
@attribute [Authorize]
@inject PunchInService PunchInService

<PageTitle>绅士签到</PageTitle>

<div class="max-w-2xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">绅士签到</h1>

    @if (loading && user == null)
    {
        <div class="flex justify-center py-12">
            <span class="loading loading-spinner loading-lg text-primary"></span>
        </div>
    }
    else
    {
        <div class="card bg-base-100 shadow-md">
            @* User header *@
            @if (user != null)
            {
                <div class="flex items-center gap-4 px-6 pt-6 pb-4 border-b border-base-200">
                    <div class="avatar">
                        <div class="w-12 rounded-full ring ring-base-300">
                            <img src="@user.Avatar" alt="avatar" />
                        </div>
                    </div>
                    <div>
                        <div class="font-semibold">@user.NickName</div>
                        <div class="flex gap-2 mt-1">
                            <span class="badge badge-primary badge-sm">连续签到 @consecutiveSign 天</span>
                            <span class="badge badge-ghost badge-sm">棒棒糖 @points</span>
                        </div>
                    </div>
                </div>
            }

            @* Calendar navigation *@
            <div class="flex items-center justify-between px-5 py-3 border-b border-base-200">
                <button @onclick="PrevMonth"
                        disabled="@(activeDate.Year == MinDate.Year && activeDate.Month == MinDate.Month)"
                        class="btn btn-ghost btn-sm text-lg">‹</button>
                <span class="font-semibold">@activeDate.Year 年 @activeDate.Month 月</span>
                <button @onclick="NextMonth"
                        disabled="@(activeDate.Year == today.Year && activeDate.Month == today.Month)"
                        class="btn btn-ghost btn-sm text-lg">›</button>
            </div>

            @* Loading bar *@
            @if (loading)
            {
                <progress class="progress progress-primary w-full rounded-none h-1"></progress>
            }

            @* Calendar grid *@
            <div class="card-body pt-4">
                <div class="grid grid-cols-7 mb-2">
                    @foreach (var h in new[] { "日", "一", "二", "三", "四", "五", "六" })
                    {
                        <div class="text-center text-xs font-medium text-base-content/50 py-1">@h</div>
                    }
                </div>
                <div class="grid grid-cols-7 gap-1">
                    @foreach (var cell in CalendarCells)
                    {
                        @if (cell == 0)
                        {
                            <div></div>
                        }
                        else
                        {
                            var dayDate = new DateOnly(activeDate.Year, activeDate.Month, cell);
                            var state = GetDayState(dayDate);
                            var clickable = state == DayState.Today || state == DayState.Missed;
                            <button @onclick="() => OnDayClick(dayDate)"
                                    disabled="@(!clickable)"
                                    class="@GetDayCss(state) aspect-square w-full rounded-full flex items-center justify-center text-sm font-medium transition-colors">
                                @cell
                            </button>
                        }
                    }
                </div>

                @if (activeDate.Month == 1 && legacySign > 0)
                {
                    <div class="alert alert-info mt-2 py-2 text-sm">
                        <span>1月25日前的连续签到数：@legacySign</span>
                    </div>
                }

                @* Legend *@
                <div class="flex gap-3 mt-3 flex-wrap">
                    <span class="flex items-center gap-1 text-xs"><span class="inline-block w-3 h-3 rounded-full bg-success"></span> 已签到</span>
                    <span class="flex items-center gap-1 text-xs"><span class="inline-block w-3 h-3 rounded-full bg-error/40"></span> 未签到（可补签）</span>
                    <span class="flex items-center gap-1 text-xs"><span class="inline-block w-3 h-3 rounded-full border-2 border-info"></span> 今天</span>
                </div>
            </div>
        </div>
    }
</div>

@* Sign-in dialog *@
<dialog class="modal @(showDialog ? "modal-open" : "")">
    <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">@dialogDate.ToString("yyyy年MM月dd日") 签到</h3>
        @if (dialogLoading)
        {
            <div class="flex justify-center py-6">
                <span class="loading loading-spinner loading-md text-primary"></span>
            </div>
        }
        else if (dialogCost != null)
        {
            <p class="mb-2">签到需要花费 <span class="font-bold">@dialogCost.Cost</span> 棒棒糖</p>
            @if (dialogCost.Cost > 0)
            {
                <p class="text-center mb-2">
                    @dialogCost.CurrentPoints → <span class="text-error font-bold">@(dialogCost.CurrentPoints - dialogCost.Cost)</span>
                </p>
            }
            @if (dialogCost.Tickets > 0)
            {
                <p class="text-base-content/60 text-sm mb-2">或使用补签券（剩余 @dialogCost.Tickets 张）</p>
            }
        }
        else
        {
            <p class="text-base-content/60 mb-2">今日签到</p>
        }
        <div class="modal-action">
            <button class="btn btn-ghost" @onclick="CloseDialog">取消</button>
            @if (dialogCost == null || dialogCost.CurrentPoints >= dialogCost.Cost)
            {
                <button class="btn btn-primary" @onclick="() => ConfirmPunchIn(false)" disabled="@signingIn">
                    @if (signingIn) { <span class="loading loading-spinner loading-xs"></span> }
                    签到
                </button>
            }
            @if (dialogCost != null && dialogCost.Tickets > 0)
            {
                <button class="btn btn-secondary" @onclick="() => ConfirmPunchIn(true)" disabled="@signingIn">使用补签券</button>
            }
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button @onclick="CloseDialog">close</button>
    </form>
</dialog>

@* Toast notification *@
@if (toastVisible)
{
    <div class="toast toast-bottom toast-center z-50">
        <div class="alert @(toastIsError ? "alert-error" : "alert-success")">
            <span>@toastMessage</span>
        </div>
    </div>
}

@code {
    // ── State ──────────────────────────────────────────────────────────────
    CurrentUser? user;
    int consecutiveSign;
    int points;
    HashSet<int> signedDays = new();
    int legacySign;
    bool loading = true;

    DateOnly today;
    DateOnly activeDate;
    static readonly DateOnly MinDate = new(2019, 1, 25);

    // Calendar cell list: 0 = empty leading/trailing cell, otherwise = day number
    IReadOnlyList<int> CalendarCells = Array.Empty<int>();

    // Dialog
    bool showDialog;
    DateOnly dialogDate;
    PunchInCost? dialogCost;
    bool dialogLoading;
    bool signingIn;

    // Toast
    bool toastVisible;
    bool toastIsError;
    string? toastMessage;
    System.Threading.CancellationTokenSource? toastCts;

    // ── Lifecycle ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(DateTime.Today);
        activeDate = new DateOnly(today.Year, today.Month, 1);

        var userTask = PunchInService.GetUserAsync();
        var histTask = PunchInService.GetHistoryAsync(today.Year, today.Month);
        await Task.WhenAll(userTask, histTask);

        user = await userTask;
        if (user != null)
        {
            consecutiveSign = user.ConsecutiveSign;
            points = user.Points;
        }

        ApplyHistory(await histTask);
        loading = false;
    }

    // ── Month navigation ───────────────────────────────────────────────────
    async Task PrevMonth()
    {
        activeDate = activeDate.AddMonths(-1);
        await LoadMonth();
    }

    async Task NextMonth()
    {
        activeDate = activeDate.AddMonths(1);
        await LoadMonth();
    }

    async Task LoadMonth()
    {
        loading = true;
        StateHasChanged();
        var hist = await PunchInService.GetHistoryAsync(activeDate.Year, activeDate.Month);
        ApplyHistory(hist);
        loading = false;
    }

    void ApplyHistory(PunchInHistoryResponse? hist)
    {
        signedDays.Clear();
        legacySign = 0;
        if (hist != null)
        {
            foreach (var h in hist.PunchIns)
            {
                if (DateTime.TryParse(h.TimeStamp, out var dt))
                    signedDays.Add(dt.Day);
            }
            legacySign = hist.LegacySignDays ?? 0;
        }
        RebuildCalendar();
    }

    void RebuildCalendar()
    {
        var first = new DateOnly(activeDate.Year, activeDate.Month, 1);
        int startOffset = (int)first.DayOfWeek; // 0=Sun
        int daysInMonth = DateTime.DaysInMonth(activeDate.Year, activeDate.Month);
        int totalCells = ((startOffset + daysInMonth + 6) / 7) * 7;

        var cells = new List<int>(totalCells);
        for (int i = 0; i < startOffset; i++) cells.Add(0);
        for (int d = 1; d <= daysInMonth; d++) cells.Add(d);
        while (cells.Count % 7 != 0) cells.Add(0);

        CalendarCells = cells;
    }

    // ── Day state & styling ────────────────────────────────────────────────
    enum DayState { Signed, Today, Missed, Future, Disabled }

    DayState GetDayState(DateOnly d)
    {
        if (d < MinDate || d > today) return DayState.Disabled;
        if (signedDays.Contains(d.Day)) return DayState.Signed;
        if (d == today) return DayState.Today;
        return DayState.Missed;
    }

    static string GetDayCss(DayState state) => state switch
    {
        DayState.Signed   => "bg-success text-success-content cursor-default",
        DayState.Today    => "border-2 border-info text-info hover:bg-info/10 cursor-pointer",
        DayState.Missed   => "bg-error/20 text-error hover:bg-error/30 cursor-pointer",
        DayState.Future   => "text-base-content/20 cursor-default",
        DayState.Disabled => "text-base-content/10 cursor-default",
        _ => "text-base-content/20"
    };

    // ── Day click → open dialog ────────────────────────────────────────────
    async Task OnDayClick(DateOnly d)
    {
        var state = GetDayState(d);
        if (state != DayState.Today && state != DayState.Missed) return;

        dialogDate = d;
        dialogCost = null;
        dialogLoading = true;
        showDialog = true;
        StateHasChanged();

        dialogCost = await PunchInService.GetCostAsync(d);
        dialogLoading = false;
        StateHasChanged();
    }

    void CloseDialog()
    {
        showDialog = false;
        signingIn = false;
    }

    // ── Confirm sign-in ────────────────────────────────────────────────────
    async Task ConfirmPunchIn(bool useTicket)
    {
        signingIn = true;
        StateHasChanged();

        var result = await PunchInService.DoPunchInAsync(dialogDate, useTicket);
        showDialog = false;
        signingIn = false;

        if (result == null)
        {
            ShowToast("签到出错，请刷新重试。", error: true);
        }
        else if (result.Success)
        {
            consecutiveSign = result.ConsecutiveDays;
            points = result.Points;
            string msg = result.ExpBonus > 0
                ? $"签到成功，棒棒糖+{result.ExpBonus}，绅士度+{result.ExpBonus}"
                : "签到成功。";
            ShowToast(msg, error: false);
            // Reload calendar data to reflect new sign
            await LoadMonth();
        }
        else
        {
            ShowToast($"签到失败：{result.ErrorMessage}", error: true);
        }
    }

    // ── Toast ──────────────────────────────────────────────────────────────
    void ShowToast(string msg, bool error)
    {
        toastCts?.Cancel();
        toastCts = new System.Threading.CancellationTokenSource();
        toastMessage = msg;
        toastIsError = error;
        toastVisible = true;
        StateHasChanged();

        var token = toastCts.Token;
        _ = Task.Delay(3000, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                toastVisible = false;
                InvokeAsync(StateHasChanged);
            }
        }, TaskScheduler.Default);
    }
}

