@page "/message"
@attribute [Authorize]

<PageTitle>消息中心</PageTitle>

<div class="max-w-6xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">消息中心</h1>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1">
            <div class="bg-white shadow-md rounded-lg p-4">
                <h2 class="font-semibold mb-4">消息类型</h2>
                <ul class="space-y-2">
                    <li class="p-2 hover:bg-gray-100 rounded cursor-pointer">全部消息</li>
                    <li class="p-2 hover:bg-gray-100 rounded cursor-pointer">系统通知</li>
                    <li class="p-2 hover:bg-gray-100 rounded cursor-pointer">私信</li>
                    <li class="p-2 hover:bg-gray-100 rounded cursor-pointer">评论回复</li>
                </ul>
            </div>
        </div>
        
        <div class="lg:col-span-2">
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-gray-600">暂无消息</p>
            </div>
        </div>
    </div>
</div>
