@page "/wheel"
@attribute [Authorize]

<PageTitle>绅士转盘</PageTitle>

<div class="max-w-4xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6 text-center">绅士转盘</h1>
    
    <div class="bg-white shadow-md rounded-lg p-8">
        <div class="flex flex-col items-center space-y-6">
            <div class="w-64 h-64 bg-gradient-to-br from-primary to-accent rounded-full flex items-center justify-center">
                <span class="text-white text-2xl font-bold">转盘</span>
            </div>
            
            <button class="bg-primary text-white px-8 py-3 rounded-full hover:bg-primary-dark transition text-lg font-semibold">
                开始转动
            </button>
        </div>
    </div>
</div>
